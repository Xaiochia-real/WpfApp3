<Window x:Class="WpfApp3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp3"
        mc:Ignorable="d"
        Title="飲料店菜單系統" Height="581" Width="1098">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="350"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="70"/>
            <ColumnDefinition Width="450"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0" Grid.Column="0" Background="#FFF7DFDF" Grid.ColumnSpan="2">
            <!-- 紅茶大杯 -->
            <StackPanel Height="34" Margin="5, 5, 5, 5" Background="#FFD5EDED" Orientation="Horizontal">
                <Label Content="紅茶大杯" FontSize="14" VerticalContentAlignment="Center" Margin="20,0,0,0" Height="26" FontWeight="Bold" Foreground="Brown"/>
                <Label Content="60元" FontSize="14" VerticalContentAlignment="Center" Margin="20,0,0,0" Height="26" FontWeight="Bold" Foreground="DarkGreen"/>
                <TextBox FontSize="14" VerticalAlignment="Center" Margin="100, 0, 0, 0" Height="26" Width="100" HorizontalContentAlignment="Right" TextChanged="TextBox_TextChanged"/>
            </StackPanel>

            <!-- 紅茶小杯 -->
            <StackPanel Height="34" Margin="5, 5, 5, 5" Background="#FFD5EDED" Orientation="Horizontal" Width="520">
                <Label Content="紅茶小杯" FontSize="14" VerticalContentAlignment="Center" Margin="20,0,0,0" Height="26" FontWeight="Bold" Foreground="Brown"/>
                <Label Content="40元" FontSize="14" VerticalContentAlignment="Center" Margin="20,0,0,0" Height="26" FontWeight="Bold" Foreground="DarkGreen"/>
                <TextBox FontSize="14" VerticalAlignment="Center" Margin="100, 0, 0, 0" Height="26" Width="100" HorizontalContentAlignment="Right" TextChanged="TextBox_TextChanged"/>
            </StackPanel>

            <!-- 綠茶大杯 -->
            <StackPanel Height="34" Margin="5, 5, 5, 5" Background="#FFD5EDED" Orientation="Horizontal">
                <Label Content="綠茶大杯" FontSize="14" VerticalContentAlignment="Center" Margin="20,0,0,0" Height="26" FontWeight="Bold" Foreground="Brown"/>
                <Label Content="60元" FontSize="14" VerticalContentAlignment="Center" Margin="20,0,0,0" Height="26" FontWeight="Bold" Foreground="DarkGreen"/>
                <TextBox FontSize="14" VerticalAlignment="Center" Margin="100, 0, 0, 0" Height="26" Width="100" HorizontalContentAlignment="Right" TextChanged="TextBox_TextChanged"/>
            </StackPanel>

            <!-- 綠茶小杯 -->
            <StackPanel Height="34" Margin="5, 5, 5, 5" Background="#FFD5EDED" Orientation="Horizontal" Width="520">
                <Label Content="綠茶小杯" FontSize="14" VerticalContentAlignment="Center" Margin="20,0,0,0" Height="26" FontWeight="Bold" Foreground="Brown"/>
                <Label Content="40元" FontSize="14" VerticalContentAlignment="Center" Margin="20,0,0,0" Height="26" FontWeight="Bold" Foreground="DarkGreen"/>
                <TextBox FontSize="14" VerticalAlignment="Center" Margin="100, 0, 0, 0" Height="26" Width="100" HorizontalContentAlignment="Right" TextChanged="TextBox_TextChanged"/>
            </StackPanel>

            <!-- 可樂大杯 -->
            <StackPanel Height="34" Margin="5, 5, 5, 5" Background="#FFD5EDED" Orientation="Horizontal" Width="520">
                <Label Content="可樂大杯" FontSize="14" VerticalContentAlignment="Center" Margin="20,0,0,0" Height="26" FontWeight="Bold" Foreground="Brown"/>
                <Label Content="50元" FontSize="14" VerticalContentAlignment="Center" Margin="20,0,0,0" Height="26" FontWeight="Bold" Foreground="DarkGreen"/>
                <TextBox FontSize="14" VerticalAlignment="Center" Margin="100, 0, 0, 0" Height="26" Width="100" HorizontalContentAlignment="Right" TextChanged="TextBox_TextChanged"/>
            </StackPanel>

            <!-- 可樂小杯 -->
            <StackPanel Height="34" Margin="5, 5, 5, 5" Background="#FFD5EDED" Orientation="Horizontal" Width="520">
                <Label Content="可樂小杯" FontSize="14" VerticalContentAlignment="Center" Margin="20,0,0,0" Height="26" FontWeight="Bold" Foreground="Brown"/>
                <Label Content="30元" FontSize="14" VerticalContentAlignment="Center" Margin="20,0,0,0" Height="26" FontWeight="Bold" Foreground="DarkGreen"/>
                <TextBox FontSize="14" VerticalAlignment="Center" Margin="100, 0, 0, 0" Height="26" Width="100" HorizontalContentAlignment="Right" TextChanged="TextBox_TextChanged"/>
            </StackPanel>
        </StackPanel>

        <Button x:Name="OrderButton" Grid.Column="2" Content="訂購" FontWeight="Bold" HorizontalAlignment="Left" Margin="50,119,0,0" VerticalAlignment="Top" Height="60" Width="120" FontSize="16" Click="OrderButton_Click"/>
        
        <!-- 下方訂購數量顯示區域，背景色為淡黃色，並跨兩欄顯示 -->
        <Border Grid.Row="1" Grid.ColumnSpan="3" Background="#FFFFF0D0" Margin="5">
            <TextBlock x:Name="ResultTextBlock" FontSize="16" Foreground="Black" Margin="10"/>
        </Border>
    </Grid>
</Window>
